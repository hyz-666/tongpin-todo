{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tongpin-todo",
  "version": "0.1.0",
  "identifier": "com.tongpin.todo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tongpin-todo",
        "width": 960,
        "height": 680,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "tongpin-todo",
    "copyright": "Copyright © 2026 tongpin-todo",
    "category": "Productivity",
    "shortDescription": "Local-first, LAN-synced todo",
    "longDescription": "tongpin-todo is a local-first todo app with encrypted storage, FTS search, and background LAN sync.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
